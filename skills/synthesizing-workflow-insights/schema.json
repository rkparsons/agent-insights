{
  "type": "object",
  "additionalProperties": false,
  "required": ["themes", "recommendations"],
  "properties": {
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "kind", "summary", "evidence_ids", "cited_quotes"],
        "properties": {
          "title": {"type": "string"},
          "kind": {"type": "string", "enum": ["friction", "opportunity"]},
          "summary": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "signal_refs": {"type": "array", "items": {"type": "string"}},
          "cited_quotes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "statement", "evidence_ids", "theme_refs", "cited_quotes"],
        "properties": {
          "type": {"type": "string", "enum": ["claude_md_rule", "new_skill", "hook", "setting", "habit"]},
          "title": {"type": "string", "minLength": 1,
            "description": "Imperative browsing handle, at most 40 characters, no trailing period, no numbers."},
          "statement": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "theme_refs": {"type": "array", "items": {"type": "integer"}},
          "cited_quotes": {"type": "array", "items": {"type": "string"}},
          "audience": {"type": "string", "enum": ["user", "orchestrator", "subagents", "both", "automation"],
            "description": "Who must see the asset for it to bind. REQUIRED for claude_md_rule; optional otherwise."}
        }
      }
    }
  }
}
